<?xml version="1.0" encoding="utf-8"?>
<!--
   Privacy-first backup rules for Orosi (حسابدار اُرسی):
   Exclude Room financial database and SharedPreferences containing bank SMS data
   from Android Auto Backup. Users manage offline backups explicitly via JSON export/import.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
