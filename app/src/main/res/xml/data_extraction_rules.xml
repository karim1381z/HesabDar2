<?xml version="1.0" encoding="utf-8"?>
<!--
   Privacy-first data extraction rules (Android 12+) for Orosi (حسابدار اُرسی):
   Exclude Room financial database and bank SMS SharedPreferences from cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="orosi_offline_db_v15_jibeman.xml" />
    </device-transfer>
</data-extraction-rules>
